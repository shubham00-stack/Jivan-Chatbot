# =============================================================================
# JIVAN Multimodal AI Assistant - Environment Configuration
# Copy this file to '.env' and fill in your API credentials.
# =============================================================================

# Application Environment
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000

# Database Configuration (MySQL with automatic SQLite dev fallback)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/multimodal_chatbot
SQLITE_FALLBACK_URL=sqlite:///./chatbot.db

# Primary AI Provider ('groq', 'gemini', or 'openai')
LLM_PROVIDER=groq

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Groq API Configuration (Fast conversational inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_MODEL=qwen/qwen3.8-27b
GROQ_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude Configuration (Coding Specialist)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Canva AI Configuration (Presentation Specialist)
CANVA_ENABLED=true

# Nano Banana AI Configuration (Visual Studio)
NANO_BANANA_MODEL=nano-banana-2.1

# Vector Store & RAG Configuration
VECTOR_STORE_DIR=./storage/vector_db
UPLOAD_DIR=./storage/uploads
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.15

# Security Guardrails & Rate Limits
ENABLE_SAFETY_GUARDRAILS=true
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=15
